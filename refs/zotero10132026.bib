	title = {U.{S}. {Pacific} {Coast} {Federal} {Fisheries} {Scenario} {Planning} {Summary} {Report}},
	url = {https://repository.library.noaa.gov/view/noaa/48949},
	doi = {10.25923/vb9r-kg26},
	abstract = {This technical memorandum summarizes the scenario planning process for U.S. Pacific Coast federal fisheries undertaken by the PFMC and the National Marine Fisheries Service, with additional support from The Nature Conservancy, the first entities in the nation to use scenario planning to explore the strategies for adapting fisheries management to climate variability and change for a suite of managed fish stocks and fisheries.},
