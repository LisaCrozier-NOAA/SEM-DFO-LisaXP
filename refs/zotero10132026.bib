	title = {Fisheries, the inverted food pyramid},
	volume = {73},
	issn = {1054-3139},
	url = {://WOS:000379358600027 https://watermark.silverchair.com/fsv225.pdf?token=AQECAHi208BE49Ooan9kkhW_Ercy7Dm3ZL_9Cf3qfKAc485ysgAAA1kwggNVBgkqhkiG9w0BBwagggNGMIIDQgIBADCCAzsGCSqGSIb3DQEHATAeBglghkgBZQMEAS4wEQQMststgbA1tkRNEPk4AgEQgIIDDKv7_W4iyWK4_uacGuOaC_5V31aZMukOSDz18o9wuiOuA5fE0qFsUCH6UDlyoEQ-5vZpzGnCC-STTAy_zEnKoAV_M9a287-GUIAYUOHXNa4hwjuaVDopKftgB3mGlu6K1jyypIbfHbk3-wKYGCj03Ki7siNQz7z_R099VRzlpUQaiolOhy-nqVEmtSnDAET4Nf8eeu5BYqJoM6Bnx0lsz7DPnqSTLI8KbOZue7RmHlLBMDlccGrwognbKXxc7cc1aFY2CI5MZ7M-PcoAisWd-ZszVvoNboO09g5RdawDCb5OkLBZV2q4KOQ602undmznX3qMz1kC6htAFG8uVdAsqZz8WfxZgd50Dr4wFkxm_Gg8_Yk6z9VLCyl__r8tnkCuz0WlWbDVvRhaKC-lcPz2Yu_Vx0TUuCzg3MIc93ysjMEual1JszJAjPZIomCEnt2Pq9fpa1k3FwfRjXvR0z8llYMieFcf-bTupPNXWVzdjpHYwweLqN2EAmL4G1vOC1IQVk6kxRJCfazSYmr6qPFj98jK3NVbXPDMiEFPvYOif7tPPKO8QOuW54AO3g-J2ECAlVF7ruJX2SQ8bfWOcrPL0qhjJaKDFCw0qTP6yktHeCJwjPiR9nOhR2jx3VlG4Zx1CRf89AyyDUmOKrNbhiAdn3qMqFmlL6mgCkmJWjc4y7-CkA_ANU848hXnmQGEg5v1x3g74ffPnbHnY3eaHKpiUeWd8DPCyA4HfpHUQDLSg3-MmfUglAjVD4fBLIkT2XDdRR19fYaxuxhPG_lAodDwwWh6Rrlm76JyCyHfMU2_d9q_f3Bb3WBTG2HeFzf_P1-y0doSv7iWrTlxgCfVfZrbgyZ_cdhj_Dy2cYL71jsLJ42TYeWIMr1rPz2HMtipeuouqB2OAWZe6hIi75t-v9ULRdXNwdt5cBUs2HPQGZ9Dvo1tbVEOnowTTR3s_KfqKUveJ0AM52osdBC_vWSpZTr3Nu9MuTGRzvNq3XItnnquzhauxeD-EahV3nCUiFotgtyFYb77AmQ0xdk5Qwv4Qw},
	doi = {10.1093/icesjms/fsv225},
	abstract = {A global assessment of fishing patterns and fishing pressure from 110 different Ecopath models, representing marine ecosystems throughout the world and covering the period 1970-2007, show that human exploitation across trophic levels (TLs) is highly unbalanced and skewed towards low productive species at high TLs, which are around two TLs higher than the animal protein we get from terrestrial farming. Overall, exploitation levels from low trophic species were, 15\% of production, and only 18\% of the total number of exploited groups and species were harvested. 40\% of their production. Generally, well-managed fisheries from temperate ecosystems were more selectively harvested at higher exploitation rates than tropical and upwelling (tropical and temperate) fisheries, resulting in potentially larger long-term changes to the ecosystem structure and functioning. The results indicate a very inefficient utilization of the food energy value of marine production. Rebuilding overfished components of the ecosystem and changing focus to balancing exploitation across a wider range of TLs, i.e. balanced harvesting, has the potential to significantly increase overall catches from global marine fisheries.},
	number = {6},
	journal = {Ices Journal of Marine Science},
