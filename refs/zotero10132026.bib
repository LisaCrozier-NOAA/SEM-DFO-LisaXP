	pages = {295--298},
}

@article{satterthwaite_ecological_2020,
	title = {Ecological thresholds in forecast performance for key {United} {States} {West} {Coast} {Chinook} salmon stocks},
	volume = {77},
	issn = {1054-3139},
	url = {://WOS:000582718700021 https://watermark.silverchair.com/fsz189.pdf?token=AQECAHi208BE49Ooan9kkhW_Ercy7Dm3ZL_9Cf3qfKAc485ysgAAAtIwggLOBgkqhkiG9w0BBwagggK_MIICuwIBADCCArQGCSqGSIb3DQEHATAeBglghkgBZQMEAS4wEQQMuyY-rqe3jMH3nMf8AgEQgIIChcTz2H0-Rr0xUWeSgKuENEpyAeCa1GyHnEF3DBfLOk4D920sSDDRmaiBiN7LzOgNq0HCdNL1nhamUsfjVl4ojxcuJh9f4gXbs6pvv4bVXy4MAtlGWcxm0SJEs6JefycTLjaJEFzw28HeANIag8J7yYXSQ1EELfzk9Y9kpqqMO1_17fd33bXciKs_4_i1aASMt6ZVuBjBKvWKiNxSyNBW0ncgLUnwncJTO2Wo-gASXwojzc2p9WeyoqdlD1z8fMTV9i74IMd4B9y90wxd6E_JzqvszoVtX-bHHZ8ILJdR3ZcsWuRPnZhIceUGsI-WkGSXZO4vPmJRXQoZhpPsfyUFqSClwZqvTvkGBRkmKDnYlZ-Ilpl7cSSKoNc3_yGnfcsBPfYnVQ6XwkqRLhH8kK0Ksr-k4doM3xl-9-nY4in0sA-66XIth8r9caSLKq09C8PpGMj4_rKXGVWNkh3kqGBr7hvKJL6zySPshXiLuoMGbi_xhlfACZoroeVKkh_kbVJQ_QfRL74CIKiviIJi6QNNTgbzcJLkN47MpDw27te6u4vueaT_bKOV6aa7DhMmgIv6kLVnLHT681kZaD_zqysknjr9w5ULl0Yzba6Ag_Sf5GZfk6Jj_VOiPphO0GtUrRpuLwDJc-iDwkpUYpEVpqv6byAOWQsk3xRjd71EnW_yULeJvc4IxYML0dLhadW2JUMp7xD9Dk9GP3tnd0UyFi9bkvwudFju2ZC5F7hn6H0gwFp8du3lO5iGajKbw-1OILWWmiwPyl5YL9I--GcI7vA_n1PREbY7ajbHXNENW-gzFDB-kE6Hk123E6gBeHI437QAy53Qtto8MdIc3v1LyURIuEaMFP41OA},
	doi = {10.1093/icesjms/fsz189},
	abstract = {Preseason abundance forecasts drive management of US West Coast salmon fisheries, yet little is known about how environmental variability influences forecast performance. We compared forecasts of Chinook salmon (Oncorhynchus tshawytscha) against returns for (i) key California-Oregon ocean fishery stocks and (ii) high priority prey stocks for endangered Southern Resident Killer Whales (Orcinus orca) in Puget Sound, Washington. We explored how well environmental indices (at multiple locations and time lags) explained performance of forecasts based on different methods (i.e. sibling-based, production-based, environment-based, or recent averages), testing for nonlinear threshold dynamics. For the California stocks, no index tested explained {\textgreater}50\% of the variation in forecast performance, but spring Pacific Decadal Oscillation and winter North Pacific Index during the year of return explained {\textgreater}40\% of the variation for the sibling-based Sacramento Fall Chinook forecast, with nonlinearity and apparent thresholds. This suggests that oceanic conditions experienced by adults (after younger siblings returned) have the most impact on sibling-based forecasts. For Puget Sound stocks, we detected nonlinear/threshold relationships explaining {\textgreater}50\% of the variation with multiple indices and lags. Environmental influences on preseason forecasts may create biases that render salmon fisheries management more or less conservative, and therefore could motivate the development of ecosystem-based risk assessments.},
	language = {English},
	number = {4},
	journal = {Ices Journal of Marine Science},
	author = {Satterthwaite, W. H. and Andrews, K. S. and Burke, B. J. and Gosselin, J. L. and Greene, C. M. and Harvey, C. J. and Munsch, S. H. and O'Farrell, M. R. and Samhouri, J. F. and Sobocinski, K. L.},
