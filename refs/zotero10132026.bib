@article{chu_warmer_2020,
	title = {Warmer temperatures enhance beneficial mutation effects},
	volume = {33},
	issn = {1010-061X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/jeb.13642},
	doi = {10.1111/jeb.13642},
	abstract = {Abstract Temperature determines the rates of all biochemical and biophysical processes, and is also believed to be a key driver of macroevolutionary patterns. It is suggested that physiological constraints at low temperatures may diminish the fitness advantages of otherwise beneficial mutations; by contrast, relatively high, benign, temperatures allow beneficial mutations to efficiently show their phenotypic effects. To experimentally test this “mutational effects” mechanism, we examined the fitness effects of mutations across a temperature gradient using bacterial genotypes from the early stage of a mutation accumulation experiment with Escherichia coli. While the incidence of beneficial mutations did not significantly change across environmental temperatures, the number of mutations that conferred strong beneficial fitness effects was greater at higher temperatures. The results therefore support the hypothesis that warmer temperatures increase the chance and magnitude of positive selection, with implications for explaining the geographic patterns in evolutionary rates and understanding contemporary evolution under global warming.},
	number = {8},
	journal = {Journal of Evolutionary Biology},
	author = {Chu, Xiao-Lin and Zhang, Da-Yong and Buckling, Angus and Zhang, Quan-Guo},
	year = {2020},
	pages = {1020--1027},
}

@article{chudy_profitability_2020,
	title = {Profitability and risk sources in global timberland investments},
	volume = {111},
	issn = {1389-9341},
	url = {://WOS:000513178500012 https://www.sciencedirect.com/science/article/pii/S1389934119302588?via%3Dihub},
	doi = {10.1016/j.forpol.2019.102037},
	abstract = {As a long-term investment, timberland investments offer financial benefits including portfolio diversification, attractive risk/return profile, an inflation hedge, and the potential of cash flow. Based on interviews with experts regarding ranges of input parameters used in single-hectare financial models and Monte Carlo simulation method, we examine what are the main factors that influence internal rates of returns (IRRs) in several global timber plantation investment opportunities: loblolly pine on the U.S. Atlantic coastal plain; Douglas-fir plantations in the western U.S.; loblolly pine and eucalyptus plantations in Brazil; radiata pine and eucalyptus plantations in Chile; and pine and oak stands in Poland. The results show that excluding the price of land, biological growth and timber prices were the most influential variables that impacted the IRRs across global timberland investments. In addition, some country-specific factors, such as planting costs (Chile) and management costs (Poland and the U.S.), were identified as crucial when considering timberland investments in these countries. Investments in South America's pine plantations are characterized by the same level of returns as eucalyptus opportunities, but with lower risk. The same was found for Douglas-fir investments in the Pacific Northwest compared to loblolly pine in the U.S. South. If Poland were an investable alternative, which is not the case so far, any investments in oak and pine stands are not recommended yet, given that for the same level of risk, better returns may be achieved in Douglas-fir plantations in the U.S. PNW. The Monte Carlo method utilized provides easily interpretable representation of the robustness of timberland investment estimates in selected regions and should become standard practice in forest-business decision making. However, more accurate probability density functions need to be determined in further research, using, for instance, historical data and kernel density estimation, rather than "lack of information" (triangular) distributions.},
	language = {English},
	journal = {Forest Policy and Economics},
	author = {Chudy, R. P. and Chudy, K. A. and da Silva, B. K. and Cubbage, F. W. and Rubilar, R. and Lord, R.},
	month = feb,
	year = {2020},
	keywords = {risk, costs, financial model, financial performance, irr, monte carlo, plantations, returns, timberland investments},
}

@article{chun_displacement_2010,
	title = {Displacement, velocity preference, and substrate use of three native {California} stream fishes in simulated pulsed flows},
	volume = {90},
