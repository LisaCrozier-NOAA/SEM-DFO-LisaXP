@article{slaughter_mandates_2010,
	title = {Mandates vs markets: {Addressing} over-allocation of {Pacific} {Northwest} {River} {Basins}},
	volume = {12},
	issn = {1366-7017},
	url = {://000278046400001},
	doi = {10.2166/wp.2009.152},
	abstract = {Water has always been the key element of human development, quality of life, and transportation in the Pacific Northwest (PNW) While seemingly abundant when mullion was first developed in the 19th Century, today many PNW rivers are fully allocated, leading to conflict in times of drought. a situation which may be exacerbated by the effects of climate change In the PNW. water is managed by an array of Federal. State. and non-governmental entities, each with its own perspective and mission This paper discusses the relative merits of solutions based on supporting market mechanisms through improved definition of water rights on the one hand, and authoritative mandates on the other},
	number = {3},
