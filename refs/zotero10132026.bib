@article{mann_effects_2007,
	title = {The effects of high temperature exposures on migration success and embryo quality of {Snake} {River} adult {Chinook} salmon and steelhead},
	abstract = {The effects of high sub-lethal water temperature exposures during adult summer and fall Chinook salmon and steelhead migration in the Snake River basin were examined on reproductive and overall migration success. Investigations included analysis of escapement through various migration reaches and embryo viability comparisons for fish with varying temperature exposures during migration. Radio telemetry was used to study migration patterns related to water temperature, while embryo viability tests were completed at Lyons Ferry, Nez Perce, and Dworshak hatcheries. 
One hundred steelhead and 100 Chinook salmon were tagged with radio transmitters and externally-mounted temperature recorders at Ice Harbor Dam from July 2 to September 30, 2004. A sub-sample of 108 fish also received internal temperature tags. Eighty nine of 200 external and 47 of 108 internal temperature tags released were recovered. Both external and internal temperature recorders were recovered from 15 individual steelhead and 16 Chinook salmon. Data from these fish indicated that internal body temperature closely tracked external water temperature and so data from both sources were used to characterize thermal exposure levels. Chinook salmon were exposed to temperatures as high as 23.6°C, and had total migration temperature exposures, recorded from Ice Harbor to Lower Granite, as high as 19.2 degree days above 20°C and 60.0 degree days above 18°C. Steelhead experienced maximum temperatures of 24°C and had total migration temperature exposures as high as 15.7 degree days above 20°C and 48.8 degree days above 18°C. Migration temperature exposures during 2004 were highly correlated with release date and the temperature at Ice Harbor Dam at the time of passage. As a result of this finding, a method iv
for estimating temperature exposures of fish was adapted using PIT tag records and the water temperature records at Ice Harbor Dam as a means to supplement sample size for this study.
Mean temperature exposure during migration was significantly greater for salmon and steelhead that did not escape to a spawning tributary in the Snake River watershed as compared to those that did reach tributaries in 2004. In addition, a significant difference was found for steelhead escaping out of the mainstem Snake River into the Clearwater or Salmon Rivers. These data imply that warm but sub-lethal water temperatures experienced by anadromous salmonids during migration in the mainstem Snake River may have an indirect or delayed effect on survival.
Embryo mortality was tracked for thirty fall Chinook salmon in 2004, and ranged from 1.1\% to 19.8\% (mean = 4.7\%), though one brood exhibited losses over 99\% due to soft shell disease. Total embryo mortality was tracked for six steelhead, and ranged from 5.7\% to 81.2\% (mean = 34.2\%) with steelhead generally having higher losses than fall Chinook salmon. Embryo mortality data in relation to temperature exposures were analyzed for 14 Chinook salmon. The five fish with the highest temperature exposures above 20°C (mean = 3.61) exhibited five of the six highest embryo mortalities at the eye-up stage and the button-up stage. A similar, but weaker, relationship was observed when temperature exposures were calculated using an 18°C threshold. Using temperatures from internal data storage tags, a significant positive linear model was developed between embryo mortality and adult migration temperature exposure. Information from this study indicates a temperature effect on embryo quality and suggests further studies on whole-system temperature exposures are needed.},
	journal = {Master's Thesis, University of Idaho},
	author = {Mann, Ryan},
	year = {2007},
	pages = {208},
}

