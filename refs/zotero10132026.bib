@techreport{zwolinski_distribution_2023,
	address = {Rockville},
	title = {{DISTRIBUTION}, {BIOMASS}, {AND} {DEMOGRAPHICS} {OF} {COASTAL} {PELAGIC} {FISHES} {IN} {THE} {CALIFORNIA} {CURRENT} {ECOSYSTEM} {DURING} {SPRING} 2021 {BASED} {ON} {ACOUSTIC}-{TRAWL} {SAMPLING}},
	abstract = {Zwolinski et al examine the distribution, biomass and demographics of coastal pelagic fishes in the California Current Ecosystem during the spring 2021 based on acoustic-trawl sampling. The spring 2021 survey was conducted principally using Lasker. The core survey area included some "good" and "optimal" habitat for the northern stock of Pacific Sardine, particularly north of Point Conception. However, the Pacific Sardine sampled in the SCB were exclusively in the nearshore region and around the northern Channel Islands, which had unsuitable habitat due to excessive chlorophyll-a concentration. Therefore, the Pacific Sardine observed in the spring 2021 survey were attributed to the southern stock.},
	institution = {U.S. National Oceanic and Atmospheric Administration (NOAA)},
	author = {Zwolinski, Juan P. and Renfree, Josiah S. and Stierhoff, Kevin L. and Demer, David A.},
