	abstract = {This report provides: 1) a detailed description of the acoustic-trawl method used by NOAA’s Southwest Fisheries Science Center (SWFSC) for direct assessments of the dominant coastal pelagic fish species (CPS), i.e.: Pacific Sardine Sardinops sagax, Northern Anchovy Engraulis mordax, Pacific Mackerel Scomber japonicus, and Jack Mackerel Trachurus symmetricus in the California Current Ecosystem (CCE) of the west coast of North America; and 2) estimates of the biomasses, distributions, and demographics of those CPS encountered in the survey area between 20 March and 13 April 2021. The core survey region, which was sampled by NOAA Ship Reuben Lasker (hereafter, Lasker), spanned most of the continental shelf between San Diego and San Francisco, California (CA). Throughout the core region, Lasker sampled along transects oriented approximately perpendicular to the coast, from the shallowest navigable depth ({\textasciitilde}30 m) to offshore distances of {\textasciitilde}75 nmi in the Southern CA Bight (SCB) and {\textasciitilde}35 nmi between Point Conception and San Francisco. To estimate the CPS biomasses in the nearshore region, where sampling by Lasker was deemed inefficient, unsafe, or both, fishing vessel (F/V) Long Beach Carnage sampled to {\textasciitilde}10 m depth along 5-nmi-long transects spaced 5 nmi apart between Point Conception and San Diego, and around Santa Cruz and Santa Catalina Islands in the SCB.},
	year = {2023},
	keywords = {Acoustic-trawl sampling, California Current Ecosystem, Coastal pelagic fishes, Southwest Fisheries Science Center},
}

@article{noauthor_fish_2021,
	title = {Fish community and abundance response to subcatchment connectivity restoration in a post-industrial river},
	abstract = {ABSTRACT:

River barrier removal and fish pass construction are increasingly used as tools to restore river connectivity, but the effectiveness of subcatchment-scale connectivity restoration on recovery of fish communities is poorly understood. We used a before-after-downstream-upstream methodology to determine the effects of subcatchment-scale connectivity restoration on fishes in a heavily fragmented subcatchment of the River Wear, Northeast England, between 2013 and 2019. Following subcatchment-scale connectivity restoration (three barriers removed, five barriers fitted with fish passes, two barriers unaltered), both resident and migratory rheophilic fish species benefitted. Total fish abundance increased three years after the restoration and remained elevated to the end of the study. Mean brown trout (Salmo trutta) density increased from 20.9 ± 6.3 per 100m2 to 33.8 ± 16.8 per 100m2 from 2013 to 2019, largely due to increased Young-of-Year (YoY) trout density, which increased from
10.6 ± 4.6 per 100m2 to 19.8 ± 11.8 per 100m2. Connectivity restoration reduced the mean age of trout, reflecting an increased migratory component. In addition, YoY trout densities were lower at ‘control’ sites compared with ‘treatment’ connectivity-restored sites. Density of bullhead (Cottus perifretum), a poorly-dispersing species, increased from 4.6 ± 2.7 per 100m2 to 32.6 ± 17.9 per 100m2 from 2013 to 2019. No Atlantic salmon (Salmo salar) were recorded over the study timescale, even though they are common in the Wear catchment, and despite suitable habitat and water quality in the restored subcatchment, suggesting a hysteresis effect. The results indicate that, where good aquatic habitat and water quality exist, restoring river connectivity at a subcatchment scale is beneficial for resident and migratory stream fishes. However, the benefits of connectivity restoration, especially in rivers with many barriers, may take several years to develop. We encourage
well-controlled long-term studies reporting the outcomes of large-scale connectivity restoration.},
	journal = {STOTEN Science of the Total Environment},
	month = may,
	year = {2021},
}

