	url = {://WOS:000457463200024 https://onlinelibrary.wiley.com/doi/full/10.1111/jfb.13864},
	doi = {10.1111/jfb.13864},
	abstract = {Median bull trout Salvelinus confluentus breeding was 2 weeks earlier in a cool stream than in a proximate warmer stream, aligning with expectations for salmonids, followed by emergence timing calculated to be 6 weeks later in the cool stream than the warm stream. This pattern is consistent with both site-specific adaptation and thermal spawning threshold hypotheses for life-history event timing in this threatened species.},
