	year = {2022},
}

@article{al-chokhachy_interactive_2021,
	title = {The interactive effects of stream temperature, stream size, and non-native species on {Yellowstone} cutthroat trout},
	volume = {78},
	issn = {0706-652x},
	url = {://WOS:000686620000006 https://cdnsciencepub.com/doi/pdf/10.1139/cjfas-2020-0408},
	doi = {10.1139/cjfas-2020-0408},
	abstract = {Climate change and non-native species are considered two of the biggest threats to native salmonids in North America. We evaluated how non-native salmonids and stream temperature and discharge were associated with Yellowstone cutthroat trout (Oncorhynchus clarkii bouvieri) distribution, abundance, and body size to gain a more complete understanding of the existing threats to native populations. Allopatric Yellowstone cutthroat trout were distributed across a wide range of average August temperatures (3.2 to 17.7 degrees C), but occurrence significantly declined at colder temperatures ({\textless}10 degrees C) with increasing numbers of non-natives. At warmer temperatures, occurrence remained high, despite sympatry with non-natives. Yellowstone cutthroat trout relative abundance was significantly reduced with increasing abundance of non-natives, with the greatest impacts at colder temperatures. Body sizes of large Yellowstone cutthroat trout (90th percentile) significantly increased with warming temperatures and larger stream size, highlighting the importance of access to these more productive stream segments. Considering multiple population-level attributes demonstrates the complexities of how native salmonids (such as Yellowstone cutthroat trout) are likely to be affected by shifting climates.},
	language = {English},
	number = {8},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	author = {Al-Chokhachy, R. and Lien, M. K. and Shepard, B. B. and High, B.},
	month = aug,
	year = {2021},
	keywords = {climate-change, brook trout, bull trout, conservation efforts, invasive hybridization, life-history characteristics, oncorhynchus-clarkii-bouvieri, rainbow-trout, salvelinus-confluentus, water temperature},
	pages = {1073--1083},
}

