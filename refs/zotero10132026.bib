
@article{noauthor_distribution_2017,
	title = {Distribution, biomass and demography of the central-stock of northern anchovy during summer 2016, estimated from acoustic-trawl sampling},
	doi = {10.7289/V5/TM-SWFSC-572},
	abstract = {"A minimum biomass estimate of the central subpopulation of northern anchovy (Engraulis mordax) in summer 2016 using the acoustic-trawl method (ATM) was determined to be 151,558 metric tons (t), CV = 41.0\%. The anchovy, ranging from the Mexican border to north of San Francisco, CA, but primarily observed north of Point Conception, had standard lengths ranging from 6 to 15 cm with a prominent mode at 11 cm. This mode is consistent with growth of the 6-cm mode observed in 2015, and indicates that the 2015 year-class currently dominates the stock in the survey area"--Summary. [doi:10.7289/V5/TM-SWFSC-572(http://doi.org/10.7289/V5/TM-SWFSC-572)]},
	year = {2017},
	keywords = {Fish stock assessment, Geographical distribution, Northern anchovy, Pacific Coast (U.S.)},
}

