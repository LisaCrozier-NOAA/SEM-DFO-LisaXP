@article{woodward_using_2021,
	title = {Using {Food} {Webs} and {Metabolic} {Theory} to {Monitor}, {Model}, and {Manage} {Atlantic} {Salmon}—{A} {Keystone} {Species} {Under} {Threat}},
	volume = {9},
