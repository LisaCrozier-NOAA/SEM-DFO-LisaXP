@article{codling_random_2008,
	title = {Random walk models in biology},
	volume = {5},
	issn = {1742-5689, 1742-5662},
	url = {https://royalsocietypublishing.org/doi/10.1098/rsif.2008.0014},
	doi = {10.1098/rsif.2008.0014},
	abstract = {Mathematical modelling of the movement of animals, micro-organisms and cells is of great relevance in the fields of biology, ecology and medicine. Movement models can take many different forms, but the most widely used are based on the extensions of simple random walk processes. In this review paper, our aim is twofold: to introduce the mathematics behind random walks in a straightforward manner and to explain how such models can be used to aid our understanding of biological processes. We introduce the mathematical theory behind the simple random walk and explain how this relates to Brownian motion and diffusive processes in general. We demonstrate how these simple models can be extended to include drift and waiting times or be used to calculate first passage times. We discuss biased random walks and show how hyperbolic models can be used to generate correlated random walks. We cover two main applications of the random walk model. Firstly, we review models and results relating to the movement, dispersal and population redistribution of animals and micro-organisms. This includes direct calculation of mean squared displacement, mean dispersal distance, tortuosity measures, as well as possible limitations of these model approaches. Secondly, oriented movement and chemotaxis models are reviewed. General hyperbolic models based on the linear transport equation are introduced and we show how a reinforced random walk can be used to model movement where the individual changes its environment. We discuss the applications of these models in the context of cell migration leading to blood vessel growth (angiogenesis). Finally, we discuss how the various random walk models and approaches are related and the connections that underpin many of the key processes involved.},
	language = {en},
	number = {25},
	urldate = {2026-02-24},
	journal = {Journal of The Royal Society Interface},
	author = {Codling, Edward A and Plank, Michael J and Benhamou, Simon},
	month = aug,
	year = {2008},
	pages = {813--834},
	file = {Full Text:C\:\\Users\\Lisa.Crozier\\Zotero\\storage\\YXPYCF7L\\Codling et al. - 2008 - Random walk models in biology.pdf:application/pdf},
}

@article{forney_role_2026,
	title = {The role of hatchery origin in early marine residence and survival of {Interior} {Columbia} {River} spring and summer {Chinook} salmon ({Oncorhynchus} tshawytscha)},
	issn = {0706-652X, 1205-7533},
	url = {https://cdnsciencepub.com/doi/10.1139/cjfas-2025-0380},
	doi = {10.1139/cjfas-2025-0380},
	abstract = {Interior Columbia River spring and summer (ICRSS) Chinook salmon are listed under the Endangered Species Act and experience persistently poor survival, despite low ocean intercept rates. Intra-annual variation in marine survival among hatcheries is often as large as interannual variation. Using parentage-based tagging, we assigned ICRSS yearlings to their hatchery of origin and evaluated how size and condition at capture varied across hatcheries and whether that variation was related to marine survival. We also compared timing and size at marine entry and early ocean growth across hatchery and wild origin yearlings. We observed consistent differences in early marine residence traits among hatcheries, indicating hatchery-specific influences on performance months after release. After accounting for interannual variability, hatchery of origin explained more of the variation ({\textasciitilde}47\%) in marine survival than body length or condition at capture, hatchery distance from the ocean ({\textasciitilde}16\%), or the number of dams passed during migration ({\textasciitilde}14\%). These findings suggest that carry-over effects associated with hatchery of origin may play a substantial role in shaping early marine survival of ICRSS Chinook Salmon.},
	language = {en},
	urldate = {2026-03-17},
	journal = {Canadian Journal of Fisheries and Aquatic Sciences},
	author = {Forney, Rebecca M. and Wallace, Amy A. and Burke, Brian J and Morgan, Cheryl A. and Miller, Jessica A.},
	month = feb,
	year = {2026},
	pages = {cjfas--2025--0380},
	file = {PDF:C\:\\Users\\Lisa.Crozier\\Zotero\\storage\\Y5G4JLCG\\Forney et al. - The role of hatchery origin in early marine residence and survival of Interior Columbia River spring.pdf:application/pdf},
}

