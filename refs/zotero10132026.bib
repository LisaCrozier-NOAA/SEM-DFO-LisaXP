@article{shirk_predicting_2023,
	title = {Predicting bycatch of {Chinook} salmon in the {Pacific} hake fishery using spatiotemporal models},
	volume = {80},
	issn = {1054-3139},
	url = {://WOS:000896825500001 https://watermark.silverchair.com/fsac219.pdf?token=AQECAHi208BE49Ooan9kkhW_Ercy7Dm3ZL_9Cf3qfKAc485ysgAAA2cwggNjBgkqhkiG9w0BBwagggNUMIIDUAIBADCCA0kGCSqGSIb3DQEHATAeBglghkgBZQMEAS4wEQQMLXu6ITiv2fosdpjTAgEQgIIDGlccFvOu_X5wqkop9fpTPRLkbLFVkUW6aeTTAVsa-8Us7pTLLLTRHA-eYRtnjirJx9msgvW0WHCWgRSmxXBMaa16H5ypE8bLGdWCEXGNWZu08xS91944XpKfFmeJvQoYuH3OgmFI2GjgCgjpwWvtklqhrjr39vaxt6z5ORjNIe0XMH80ClfssAnMihlS3APqVzA1Z7jflZ4zgmcZXtSGtRo8Z2gLujNjh0Pw6CwspA41LFhCrAikqd5CAyhOD6P4Kw6oO5oTiNYulyBSn70R8T6N10232Fb0NzCQ0S7OLwrQcVkOWY_r0T43pTrxjRZfQG9c_oFQDeJ8ZmeMNPeiyOeXCpYi3v0Mqsg3l47Lzkr54Z25QHNth_90eMTojfI2CzEs-5MzGSv05fB_WhCdSHqKctw1BU-udskk1lovWiPB8ohFxKrRrkMeG5dWbbzfzzhapIqcAvm6w9XCTEaXGBHfXFN9ANfU1mJW_jGe6UBcPeeLHfORuvrRRbMs7_fdLNB8_xBWEBSgZF1H5Rs8WKQQX-dki59PCxV37XNv-gWrpje1r3JCsuOK6w85hZl5LaVmpRR2ed4OwWJv_vokosSFUq9q3k-uhXEhKYjUzqlSUkDlK-BlyyVQHyWDfCqiNASBvxzQms7-ToXU22DGRsijfQY3SwS5ktHUUYalA7jsaq3F-_3L9e1GH6IuBWua2sCDI4bL63MZ_SrbeiWKgiGSo9Gfi0dZGAWDz2HV_faKlpt3GUb-pVpar8xbHSQGaeFDwpzL0jXZ2YfH2npo6w6pN2veRukIAebnOZXH0ev56cRS0df3P2ncOp0aIQIlHN7pasleoCm1dJ7dvyEDUOX14HWGhwHhKE88iC9ZnTQg41gAHN-kKKjToZrfuE7XHWWlMAgBeiXBf3fE3yxgZiPvPAZDR2kzn68IWUn_rwq1Nmb98Kyp0VAqdavKDnESTr-mi780rWmEBPPa253h17GtyRjXMaMQ-XFRm8ESCZjDoABF2lKXGXHJSLAey6WXC3GroHIegYvXF9XIH73eoC-3YzYGH-PBviCF},
	doi = {10.1093/icesjms/fsac219},
	abstract = {Fisheries bycatch is a global problem, and the ability to avoid incidental catch of non-target species is important to fishermen, managers, and conservationists. In areas with sufficient data, spatiotemporal models have been used to identify times and locations with high bycatch risk, potentially enabling fishing operations to shift their effort in response to the dynamic ocean landscape. Here, we use 18 years of observer data from the Pacific hake (Merluccius productus) fishery, the largest by tonnage on the US West Coast, to evaluate our ability to predict bycatch of the commercially, culturally, and ecologically important Chinook salmon (Oncorhynchus tshawytscha). Using multiple approaches (regression models, tree-based methods, and model averages), we tested our ability to predict bycatch at weekly and yearly timescales and found that spatiotemporal models can have good predictive ability. Gradient boosting trees (GBTs) and model averages typically had higher performance, while generalized linear models and generalized additive models (without interaction terms) did less well. Using a GBT model to remove 1\% of hauls with the highest predicted bycatch reduced the bycatch-to-hake ratio by 20\%. Our results indicate that spatiotemporal models may be a useful forecasting tool that can help fishing operations avoid bycatch while minimizing losses from target catches.},
	number = {1},
	journal = {Ices Journal of Marine Science},
	author = {Shirk, P. L. and Richerson, K. and Banks, M. and Tuttle, V.},
	month = jan,
	year = {2023},
	pages = {133--144},
}

@article{shitova_differentiation_2020,
	title = {Differentiation of {Asian} {North} {Chum} {Salmon} ({Oncorhynchus} {ketaW}.) {Based} on {Microsatellite} {Markers}},
	volume = {56},
	issn = {1022-7954},
	url = {://WOS:000545660000007 https://link.springer.com/content/pdf/10.1134/S1022795420060113.pdf},
	doi = {10.1134/S1022795420060113},
	abstract = {The study includes 41 sample sets of chum salmon from the northern part of its geographic range analyzed at ten microsatellite loci. In the northern part of the range of Asian chum salmon, the following groups of samples are clearly distinguished: "Magadan oblast," "Northern Kamchatka," "Penzhina River," and "Anadyr River basin." Populations of chum salmon from the Apuka River and the "Koryak Upland" group show low genetic differentiation from other groups. There is a positive relationship between the latitude and the average expected heterozygosity in this part of the range. Chum salmon of the Penzhina River shows close genetic relationship to chum salmon from the Anadyr River basin, probably because of gene flow.},
	language = {English},
	number = {6},
	journal = {Russian Journal of Genetics},
	author = {Shitova, M. V. and Khokhlov, Y. N. and Nikiforov, A. I. and Afanasyev, P. K. and Orlova, S. Y. and Elnikov, A. N. and Bugaev, A. V. and Rakitskaya, T. A. and Prohorovskaya, V. D. and Malinina, T. V. and Politov, D. V. and Afanasyev, K. I. and Rubtsova, G. A. and Zhivotovsky, L. A.},
	month = jun,
	year = {2020},
	keywords = {population genetics, population-structure, chum salmon, microsatellite loci, genetic differentiation, oncorhynchus keta, chukotka, far-east},
	pages = {706--717},
}

@article{shrestha_heterogeneous_2021,
	title = {Heterogeneous snowpack response and snow drought occurrence across river basins of northwestern {North} {America} under 1.0 degrees {C} to 4.0 degrees {C} global warming},
	volume = {164},
	issn = {0165-0009},
	url = {://WOS:000619159100001 https://link.springer.com/content/pdf/10.1007/s10584-021-02968-7.pdf},
	doi = {10.1007/s10584-021-02968-7},
	abstract = {Anthropogenic climate change is affecting the snowpack freshwater storage, with socioeconomic and ecological impacts. We present an assessment of maximum snow water equivalent (SWEmax) change in large river basins of the northwestern North America region using the Canadian Regional Climate Model 50-member ensemble under 1.0 degrees C to 4.0 degrees C global warming thresholds above the pre-industrial period. The projections indicate steep SWEmax decline in the warmer coastal/southern basins (i.e., Skeena, Fraser and Columbia), moderate decline in the milder interior basins (i.e., Peace, Athabasca and Saskatchewan), and either a small increase or decrease in the colder northern basins (i.e., Yukon, Peel, and Liard). A key factor for these spatial differences is the proximity of winter mean temperature to the freeze/melt threshold, with larger SWEmax declines for the basins closer to the threshold. Using the random forests machine-learning model, we find that the SWEmax change is primarily temperature controlled, especially for warmer basins. Further, under a categorical framework of below-normal SWEmax defined as snow drought (SD), we find that above-normal temperature and precipitation are the dominant conditions for SD occurrences under higher global warming thresholds. This implies a limited capacity of precipitation increase to compensate the temperature-driven snowpack decline. Additionally, the frequency and severity of SD occurrences are projected to be most extreme in the southern basins where current water demands are highest. Overall, the results of this study, including insights on snowpack changes, their climatic controls, and the framework for SD classification, are applicable for basins spanning a range of hydro-climatological regimes.},
	language = {English},
	number = {3-4},
	journal = {Climatic Change},
	author = {Shrestha, R. R. and Bonsal, B. R. and Bonnyman, J. M. and Cannon, A. J. and Najafi, M. R.},
	month = feb,
	year = {2021},
	keywords = {climate-change, sockeye-salmon, temperature, impacts, precipitation, model, british-columbia, arctic amplification, climatic controls, global mean temperature change, land-surface scheme, large ensemble rcm, northwestern north america, projected changes, snow drought},
}

@article{shrimpton_freshwater_2014,
	title = {Freshwater movement patterns by juvenile {Pacific} salmon {Oncorhynchus} spp. before they migrate to the ocean: {Oh} the places you'll go!},
	volume = {85},
	issn = {0022-1112},
	url = {://WOS:000342828400001 http://onlinelibrary.wiley.com/store/10.1111/jfb.12468/asset/jfb12468.pdf?v=1&t=ibdvbhrz&s=8cb77a19d70110676da17ae6fa1f17d680b37f3c},
	doi = {10.1111/jfb.12468},
	abstract = {Juvenile movement patterns for coho salmon Oncorhynchus kisutch and Chinook salmon Oncorhynchus tshawytscha from two large interior rivers of British Columbia, Canada, were examined. Otoliths from post-spawned fishes were collected on spawning grounds and elemental signatures were determined through transects from sectioned otoliths using laser ablation-inductively coupled plasma-mass spectrometry (LA-ICP-MS). Large variations in otolith elemental signatures were found during the freshwater life stage indicative of movement downstream to rivers and tributaries that differed in elemental signature. This study highlights that downstream movements occur before migration to the ocean during the parr-smolt transformation. Extensive downstream movements of parr appear to be a successful life-history strategy based on variations observed in the otolith elemental signatures of spawners. Movements downstream in parr and the remarkable homing ability of adults also suggest that imprinting to natal streams must occur prior to the parr-smolt transformation. (C) 2014 The Fisheries Society of the British Isles},
	number = {4},
	journal = {Journal of Fish Biology},
	author = {Shrimpton, J. M. and Warren, K. D. and Todd, N. L. and McRae, C. J. and Glova, G. J. and Telmer, K. H. and Clarke, A. D.},
	month = oct,
	year = {2014},
	pages = {987--1004},
}

@article{shulgina_effect_2021,
	title = {Effect of the photoperiod on the growth and development of salmonids in northern latitudes},
	volume = {82},
	issn = {0044-4596},
	url = {://WOS:000635239900006},
	doi = {10.31857/S0044459621010073},
	abstract = {One of the factors affecting growth, development, feeding behavior, and metabolism of fish is the length of daylight hours (photoperiod). The use of different regimes for regulating the photoperiod during the development ofjuvenile salmon has an effect on the time of the transformation of the parr into smolt (smoltification process), which, under conditions of artificial cultivation, contributes to their earlier transfer to sea water. The exposure of some salmonids to prolonged periods of light has been shown to be critical in delaying maturity once individuals reach the required size. Data on the synergistic effect of temperature and photoperiod on the growth and reproductive cycle of salmonids with the aim of accelerating or delaying the development of oocytes are also discussed. The published and own research data on the influence of light regimes on the formation and growth of skeletal muscles (on the gene expression profiles in white muscles, the expression of myogenic regulatory factors, along with changes in the levels of energy and carbohydrate metabolism) in salmonids are presented.},
	language = {Russian},
	number = {1},
	journal = {Zhurnal Obshchei Biologii},
	author = {Shulgina, N. S. and Churova, M. V. and Nemova, N. N.},
	month = jan,
	year = {2021},
	keywords = {atlantic salmon, rainbow-trout, salar l., sexual-maturation, factor-i, parr-smolt transformation, continuous light, different temperatures, feed conversion rate, seawater stages},
	pages = {68--80},
}

@article{shuntov_climate_2019,
	title = {Climate {Change} and the {Current} {Status} of {Biota} in {Russian} {Waters} of the {Far} {Eastern} {Seas}},
	volume = {45},
	issn = {1063-0740},
	url = {://WOS:000512774100001 https://link.springer.com/content/pdf/10.1134/S1063074019070058.pdf},
	doi = {10.1134/s1063074019070058},
	abstract = {This article continues the discussion about the limiting influence of climate conditions on the dynamics of Pacific salmon abundance and on the status of biological resources in the Far Eastern seas. The conclusion that the multifactor impacts of climatic and hydrological conditions on populations and communities cannot be described only by climatic indices and sea surface temperature anomalies in the cold season is substantiated. A comparison of bioresource stocks between various regions of the Far Eastern seas shows a positive effect of modern global warming on the condition and sustainability of the fisheries resource base.},
	number = {7},
	journal = {Russian Journal of Marine Biology},
	author = {Shuntov, V. P. and Ivanov, O. A.},
	month = dec,
	year = {2019},
	pages = {495--510},
}

