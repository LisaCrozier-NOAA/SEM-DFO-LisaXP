	keywords = {restoration, water temperature, pacific-northwest, salmon, stream temperature, northern california, watershed, forest, landscape ecology, forest restoration, headwater, western oregon, riverscape, coast redwood forests, cumulative effects, downstream propagation, patch dynamics, riparian thinning, spatiotemporal variability, temperature response, waveform analysis},
