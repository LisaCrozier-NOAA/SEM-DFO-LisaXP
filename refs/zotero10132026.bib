Seattle Times: Emissions not the cause of West Coast warming {\textless}http://seattletimes.com/html/localnews/2024601865\_climateweatherstudyxml.html{\textgreater}},
	number = {40},
	journal = {Proceedings of the National Academy of Sciences of the United States of America},
	author = {Johnstone, J. A. and Mantua, N. J.},
	month = oct,
	year = {2014},
	pages = {14360--14365},
}

@article{johnstone_reply_2014,
	title = {Reply to {Abatzoglou} et al.: {Atmospheric} controls on northwest {United} {States} air temperatures, 1948-2012},
	volume = {111},
	url = {www.pnas.org/cgi/doi/10.1073/pnas.1421618112},
	abstract = {Abatzoglou et al. speculate that SLP indices from HadSLP2 and 20th Century Reanalysis (20CR) datasets may be more reliable than NCAR, particularly before 1921. Based on statistical tests in our report we remain confident in the superiority of NCAR SLP in the northeastern Pacific before 1921. A second issue raised by Abatzoglou et al. is the applicability of our findings to 1948–2012 surface warming in the northwestern United States from 49° to 42°N and 125° to 110°W, a region that extends considerably further inland than any we considered. Here we first show that, within this region, coastal SATs west of 120°W correlate with 20CR SLP similarly to our long-term SLP1 index, with warmth promoted by cyclonic wind anomalies, low SLP, and a weak ocean–land SLP gradient in the NE Pacific region. Contrary to claims by Abatzoglou et al., recent SLP changes support our original findings during a period when NCAR, HadSLP2, and 20CR SLP are in generally good agreement.},
	number = {52},
	journal = {Proceedings of the National Academy of Sciences},
	author = {Johnstone, J.A. and Mantua, N.J.},
	year = {2014},
	pages = {E5607--E5608},
}

