	year = {2019},
	keywords = {California Current, Geographical distribution, Fish populations, Fisheries, Ecosystem management, Coastal ecology, Evaluation, Fishes, Analysis, Aquatic biodiversity conservation, Bottom fishing, Climatic changes, Coastal ecosystem health, Economic zones (Law of the sea), Ecosystem health, Fishing, Fishing ports, Groundfishes, Human activity recognition, Indicators (Biology), Marine species diversity, Versification},
