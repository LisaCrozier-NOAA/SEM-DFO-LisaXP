	volume = {76},
	issn = {1054-3139},
	url = {://WOS:000501732500001 https://watermark.silverchair.com/fsz114.pdf?token=AQECAHi208BE49Ooan9kkhW_Ercy7Dm3ZL_9Cf3qfKAc485ysgAAA3UwggNxBgkqhkiG9w0BBwagggNiMIIDXgIBADCCA1cGCSqGSIb3DQEHATAeBglghkgBZQMEAS4wEQQMu3uzx9ev2GNPC5QmAgEQgIIDKIbkXKjc5KlyhNazNEBbkv5LUy1l8aojlaTEgBsD8VDJEVvsDj9RfpyhXRkR469aGfjEQSNIngNNKFPOvPfQckcZMXRGyb3oxdyyG0yQrTRx0b80TS123K9gNyC1RV20mOkgagjSd5WAkR1HlKAz9vblCB-y-GEqP4vkNKjbLhoO-YwI00ne3rzi2ZJthVpKGWZknZ8ex5yYhs4PajYqcyukcOx12in7EsE7ecDzFVydzZIEweY4bTT1UL3RdjIl7vLILr6l9UKU8ItL9r_DjpegOhydKizCHDG80jwNGU1TWh3rGIo4KWFpT4-JnXSXps6_4c2z_dwCFW86EA6olzhUZiPQVNcsjCiBftObNl5L3JFCl6aUFS5mFPG9J_efqDrySuxK6SQdYg-Iq0m2OpdZ4GkytKcclwdomTaBWUjZVtPnxDufk-TmnHazB60_tOhjxdkfZDQxBMzqIQc-yfGHg4IrlEImhqV5KpGHPME5e0DMMoCOKX0HfXQvlWVAaxT-jp7GF-rgfJchVCu46ZgW8AX3Q7AQrYMPzJlWpFfrL-svS0Zh3UmuQ61Ue0veUqUKYMXZkSF5dkdWCQTAW-DtAGRB-kef1KUoCOK200aNfLYApwRVa-0DK8GSLQOITYRmodP2agCK5o6DhlxrL7rD0AmEDMMOmCCR9uEQq2rQciXgSFcCIpUdWKQsXmtYw0IUQc2nRpedVlNxYTGbfyT8T0xZpykEVX7UeRWzlOZJzFH0iWWUk94wvrmPUJPmDa-GZ6YJ4fmaNcx5VaLX06Vg6t1X0L86etceIbjwffQEmO8_rqVCYHJCG-cRZ1GbNN9FGqg9P40mHLY8jI_Xs_LJL9dwmcBuyIEKYpZ0PIu7TtpdPUr0qvJFivc0los4yZDfDwvw8IjTvYEr3-CA42NvFt-nl9thfLQujwovoZzdq66gBcXcA7nP1GLvoitE5uhO1gz_G0laphxPZona5uNGqJNiDMnj2l9n5q0rVIjOcsG8FXzNeouW8d6n_jl1kALCLjfVh7LSQhVMEWcIYten0weRTfBQ2xJ1m9ggglmNtf__vqx79lQ},
	doi = {10.1093/icesjms/fsz114},
	abstract = {Combining detailed temporal and spatial catch data, including catch per unit effort, with a high-resolution microsatellite genetic baseline facilitated the development of stock-specific coastal migration models for the four largest Atlantic salmon (Salmo salar) populations, Malselv, Alta, Tana and Kola rivers, contributing to the Barents Sea mixed-stock fishery. Malselv salmon displayed a restricted coastal movement with 85\% of the fish captured within 20 km of their natal river. Kola salmon also demonstrated limited coastal movements in Norwegian waters, with most ({\textgreater} 90\%) caught in eastern Finnmark. Multi-sea-winter (MSW) Alta salmon were caught west of Alta fjord across a broader stretch of coast while one-sea-winter (1SW) fish migrated more extensively along the coast prior to river entry. Tana salmon, however, were detected over a broad expanse (600 km) of the North-Norwegian coast. For all populations MSW salmon dominating catches earlier in the season (May-June) while 1SW fish were more common from July to August. This study provides an example of how traditional catch and effort information may be combined with genetic methods to obtain insights into spatial and temporal changes in Atlantic salmon catch composition and their associated migration patterns in a mixed-stock coastal fishery.},
	number = {6},
	journal = {Ices Journal of Marine Science},
	author = {Svenning, M. A. and Falkegård, M. and Niemelä, E. and Vähä, J. P. and Wennevik, V. and Ozerov, M. and Prusov, S. and Dempson, J. B. and Power, M. and Fauchald, P.},
	month = nov,
	year = {2019},
	keywords = {conservation genetics, genetic, GSI, review},
	pages = {1379--1389},
}

